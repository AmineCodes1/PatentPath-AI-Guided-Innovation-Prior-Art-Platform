# PatentPath environment variables
# Copy this file to .env and replace placeholder values.

# Database and cache
POSTGRES_DB=patentpath
POSTGRES_USER=patentpath
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://patentpath:change_me@postgres:5432/patentpath
REDIS_URL=redis://redis:6379/0

# EPO OPS credentials (optional — leave blank to use built-in demo patents)
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=

# Ollama (local LLM)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b

# Auth
JWT_SECRET_KEY=replace_with_a_64_char_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API and CORS
CORS_ORIGINS=http://localhost:5173,http://localhost
